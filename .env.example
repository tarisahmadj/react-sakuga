# Port Aplikasi Host
APP_PORT=3000
NODE_ENV=development
TZ=Asia/Jakarta

# Secret Key untuk Signed Session Cookie (Ganti di Production)
AUTH_SECRET=change-this-to-a-secure-random-secret-key

# Koneksi ke container PostgreSQL (postgres15 pada network docker-infra_default)
DB_HOST=postgres15
DB_PORT=5432
DB_NAME=sakuga_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres15:5432/sakuga_db
